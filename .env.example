# Usar proxy de Next.js en el navegador (misma origin → cookies funcionan)
NEXT_PUBLIC_API_URL=/api/v1

# Destino real del backend para el rewrite de Next.js
API_PROXY_TARGET=http://localhost:8000

# URL directa para Server Components (SSR)
API_URL_INTERNAL=http://localhost:8000/api/v1

# URL pública del frontend (canónicos, Open Graph, sitemap).
# En producción: https://tudominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secreto compartido entre el proxy de Next.js y el backend FastAPI para confiar en X-Chivapp-Client-Ip
PROXY_SHARED_SECRET=

# Número de saltos de proxy reverso confiables (1 = balanceador directo delante de Next.js)
TRUSTED_PROXY_HOPS=1

# Endpoint para reportes de Content-Security-Policy (Report-Only)
CSP_REPORT_URI=/api/csp-report
